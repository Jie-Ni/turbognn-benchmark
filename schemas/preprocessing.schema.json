{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jie-Ni/turbognn-benchmark/schemas/preprocessing.schema.json",
  "title": "Split-safe preprocessing configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "input_expression_state", "input_expression_evidence",
    "normalization_method", "normalize_total_target_sum", "log1p_pseudocount",
    "log1p_base", "hvg_fit_scope", "scaler_fit_scope", "coexpression_fit_scope",
    "hvg_method", "hvg_flavor", "scaler_ddof", "scaler_epsilon",
    "scaler_constant_scale", "coexpression_method", "coexpression_threshold",
    "coexpression_threshold_rule", "coexpression_constant_nan_policy",
    "coexpression_symmetry_policy", "coexpression_self_loop_policy",
    "cell_qc_policy", "perturbation_type_policy", "batch_policy",
    "multi_target_policy", "minimum_control_cells", "minimum_perturbed_cells"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "input_expression_state": {"enum": ["raw_counts", "log1p_normalized"]},
    "input_expression_evidence": {"type": "string", "minLength": 1},
    "normalization_method": {"enum": ["scanpy_normalize_total_then_log1p", "identity_preverified_log1p"]},
    "normalize_total_target_sum": {"const": 10000.0},
    "log1p_pseudocount": {"const": 1.0},
    "log1p_base": {"type": "null"},
    "hvg_fit_scope": {"const": "control_only"},
    "scaler_fit_scope": {"const": "control_only"},
    "coexpression_fit_scope": {"const": "control_only"},
    "hvg_method": {"const": "scanpy_highly_variable_genes"},
    "hvg_flavor": {"const": "seurat"},
    "scaler_ddof": {"const": 0},
    "scaler_epsilon": {"const": 1e-8},
    "scaler_constant_scale": {"const": 1.0},
    "coexpression_method": {"const": "pearson"},
    "coexpression_threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "coexpression_threshold_rule": {"const": "strict_abs_gt"},
    "coexpression_constant_nan_policy": {"const": "exclude_edge"},
    "coexpression_symmetry_policy": {"const": "simple_undirected_then_bidirectional"},
    "coexpression_self_loop_policy": {"const": "one_per_gene"},
    "cell_qc_policy": {"const": "source_filtered_matrix_no_additional_cell_filter"},
    "perturbation_type_policy": {"const": "explicit_mapped_single_or_multi_target"},
    "batch_policy": {"const": "no_batch_correction"},
    "multi_target_policy": {"const": "retain_all_explicit_mapped_targets"},
    "minimum_control_cells": {"type": "integer", "minimum": 2},
    "minimum_perturbed_cells": {"const": 20}
  }
}

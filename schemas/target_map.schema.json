{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jie-Ni/turbognn-benchmark/schemas/target_map.schema.json",
  "title": "TDS-02 canonical perturbation target maps",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {"$ref": "#/$defs/datasetTargetMap"},
  "$defs": {
    "nonblankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:.*\\S)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "designFieldSchema": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source_value_policy"],
          "properties": {
            "type": {"const": "nfc_string"},
            "source_value_policy": {"const": "retain_nfc_unmodified"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "controlled_units", "conversion_evidence"],
          "properties": {
            "type": {"const": "canonical_quantity"},
            "controlled_units": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/nonblankString"}
            },
            "conversion_evidence": {"$ref": "#/$defs/nonblankString"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"enum": ["integer", "boolean"]}}
        }
      ]
    },
    "canonicalQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "unit": {"$ref": "#/$defs/nonblankString"}
      }
    },
    "designValue": {
      "oneOf": [
        {"$ref": "#/$defs/nonblankString"},
        {"$ref": "#/$defs/canonicalQuantity"},
        {"type": "integer"},
        {"type": "boolean"}
      ]
    },
    "canonicalObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ids",
        "target_identifier_namespace",
        "target_identifier_release",
        "target_mapping_table_sha256",
        "perturbation_type",
        "design_fields"
      ],
      "properties": {
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonblankString"}
        },
        "target_identifier_namespace": {"$ref": "#/$defs/nonblankString"},
        "target_identifier_release": {"$ref": "#/$defs/nonblankString"},
        "target_mapping_table_sha256": {"$ref": "#/$defs/sha256"},
        "perturbation_type": {"$ref": "#/$defs/nonblankString"},
        "design_fields": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/designValue"}
        }
      }
    },
    "rawCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_object", "target_genes", "normalization_evidence"],
      "properties": {
        "canonical_object": {"$ref": "#/$defs/canonicalObject"},
        "target_genes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonblankString"}
        },
        "normalization_evidence": {"$ref": "#/$defs/nonblankString"}
      }
    },
    "datasetTargetMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "canonicalization_evidence",
        "allowed_perturbation_types",
        "design_field_schema",
        "raw_conditions"
      ],
      "properties": {
        "evidence": {"$ref": "#/$defs/nonblankString"},
        "canonicalization_evidence": {"$ref": "#/$defs/nonblankString"},
        "allowed_perturbation_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonblankString"}
        },
        "design_field_schema": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/designFieldSchema"}
        },
        "raw_conditions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/rawCondition"}
        }
      }
    }
  }
}

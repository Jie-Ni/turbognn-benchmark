{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jie-Ni/turbognn-benchmark/schemas/run_manifest.schema.json",
  "title": "TurboGNN run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planned_total",
    "status_counts",
    "manifest_hash",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "planned_total": {"type": "integer", "minimum": 1},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed", "planned", "queued", "running", "skipped", "succeeded"],
      "properties": {
        "failed": {"type": "integer", "minimum": 0},
        "planned": {"type": "integer", "minimum": 0},
        "queued": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/runRecord"}
    }
  },
  "$defs": {
    "runRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "input_hash",
        "environment_lock_hash",
        "gene_panel_hash",
        "condition_panel_hash",
        "preprocessing_hash",
        "dataset_passport_registry_hash",
        "dataset_passport_hash",
        "matrix_contract_hash",
        "control_selection_hash",
        "target_mapping_hash",
        "condition_eligibility_ledger_hash",
        "cell_qc_policy_hash",
        "response_definition_hash",
        "graph_type",
        "graph_instance",
        "graph_hash",
        "graph_source_config_hash",
        "graph_ensemble_config_hash",
        "graph_contract_hash",
        "model_name",
        "model_config_hash",
        "input_contract_policy_hash",
        "input_definition_hash",
        "configuration_universe_hash",
        "schedule_manifest_hash",
        "schedule_content_hash",
        "schedule_configuration_hash",
        "split_hash",
        "code_commit",
        "seed",
        "fold_seed",
        "condition",
        "status",
        "result_path",
        "result_hash",
        "failure_reason",
        "skip_reason"
      ],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_lock_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gene_panel_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "condition_panel_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preprocessing_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset_passport_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset_passport_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "matrix_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "control_selection_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_mapping_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "condition_eligibility_ledger_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cell_qc_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "response_definition_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "graph_type": {"type": "string", "minLength": 1},
        "graph_instance": {"type": "string", "minLength": 1},
        "graph_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "graph_source_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "graph_ensemble_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "graph_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_name": {"type": "string", "minLength": 1},
        "model_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_contract_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_definition_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "configuration_universe_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schedule_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schedule_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schedule_configuration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "split_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "seed": {"type": "integer"},
        "fold_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "condition": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["planned", "queued", "running", "succeeded", "failed", "skipped"]
        },
        "result_path": {"type": ["string", "null"]},
        "result_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "failure_reason": {"type": ["string", "null"]},
        "skip_reason": {"type": ["string", "null"]}
      }
    }
  }
}

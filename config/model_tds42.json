{
  "schema_version": "1.0.0",
  "precision": "float32",
  "deterministic_algorithms": true,
  "feature_encoder": {
    "gene_embedding_dim": 32,
    "input_dim": 68,
    "features": [
      "gene_identity_embedding",
      "control_precentering_mean",
      "control_log1p_variance",
      "target_mask",
      "mean_pooled_target_gene_embedding_broadcast",
      "log1p_target_count_broadcast"
    ],
    "projection": "Linear68to128_LayerNorm_ELU",
    "embedding_initialization": "normal_mean_0_std_1",
    "embedding_max_norm": null,
    "embedding_norm_type": 2.0,
    "embedding_scale_grad_by_freq": false,
    "embedding_sparse": false,
    "projection_linear_bias": true,
    "layer_norm_eps": 1e-05,
    "layer_norm_elementwise_affine": true,
    "layer_norm_bias": true,
    "elu_alpha": 1.0
  },
  "gat": {
    "hidden_dim": 128,
    "layers": 3,
    "heads": 8,
    "concat": false,
    "add_self_loops": false,
    "explicit_graph_self_loops": true,
    "batch_norm_each_layer": true,
    "activation": "ELU",
    "attention_coefficient_dropout": 0.0,
    "dropout": 0.1,
    "dropout_after_layers": [1, 2],
    "linear_residual_into_layer": 3,
    "decoder": "Linear128to1_delta",
    "negative_slope": 0.2,
    "bias": true,
    "residual": false,
    "edge_dim": null,
    "fill_value": "mean",
    "aggregation": "add",
    "flow": "source_to_target",
    "node_dim": 0,
    "decomposed_layers": 1,
    "batch_norm_eps": 1e-05,
    "batch_norm_momentum": 0.1,
    "batch_norm_affine": true,
    "batch_norm_track_running_stats": true,
    "residual_linear_bias": true,
    "decoder_linear_bias": true,
    "elu_alpha": 1.0
  },
  "transformer": {
    "d_model": 128,
    "layers": 2,
    "heads": 4,
    "feedforward_dim": 256,
    "pre_norm": true,
    "activation": "ReLU",
    "dropout": 0.1,
    "decoder": "Linear128to1_delta",
    "bias": true,
    "batch_first": true,
    "layer_norm_eps": 1e-05,
    "encoder_norm": null,
    "encoder_enable_nested_tensor": true,
    "encoder_mask_check": true,
    "decoder_linear_bias": true
  },
  "training": {
    "loss": "MSE_mean_over_genes",
    "optimizer": "AdamW",
    "learning_rate": 0.0005,
    "weight_decay": 0.0001,
    "betas": [0.9, 0.999],
    "epsilon": 1e-08,
    "adamw_amsgrad": false,
    "adamw_maximize": false,
    "adamw_foreach": false,
    "adamw_capturable": false,
    "adamw_differentiable": false,
    "adamw_fused": false,
    "epochs": 50,
    "condition_batch_size": 1,
    "parameter_initialization_seed_policy": "top_level_training_seed",
    "fold_order_seed_policy": "sha256_training_seed_condition_split_v1",
    "condition_order_policy": "sha256_fold_seed_epoch_nfc_condition_v1",
    "scheduler": "CosineAnnealingLR",
    "scheduler_t_max": 50,
    "scheduler_eta_min": 0.0,
    "gradient_l2_clip": 1.0,
    "gradient_clip_norm_type": 2.0,
    "gradient_clip_error_if_nonfinite": true,
    "gradient_clip_foreach": false,
    "early_stopping": false,
    "training_seeds": [42, 43, 44]
  },
  "runtime": {
    "torch_float32_matmul_precision": "highest",
    "cuda_matmul_allow_tf32": false,
    "cudnn_allow_tf32": false
  },
  "repair_policy": "TDS34_one_failure_diagnostic_only_repair_no_outcome_tuning"
}
